# Provision this LOGIN without superuser, create-db, create-role, or bypass-RLS.
APP_DATABASE_URL=postgresql://starter_runtime:local-password@127.0.0.1:5432/starter?sslmode=disable
# Optional separate Auth login; defaults to APP_DATABASE_URL.
AUTH_DATABASE_URL=postgresql://starter_runtime:local-password@127.0.0.1:5432/starter?sslmode=disable
BETTER_AUTH_URL=http://localhost:3000
# Replace with a random secret containing at least 32 characters.
BETTER_AUTH_SECRET=
# Closed by default. Only the exact value true opens signup after owner setup.
APP_ALLOW_SIGN_UP=false
# SHA-256 only; run owner:setup then owner:open to open a one-time setup link privately.
APP_OWNER_SETUP_HASH=
# Optional: AG Grid / AG Charts Enterprise keys. See docs/ag-enterprise.md.
# NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
# NEXT_PUBLIC_AG_CHARTS_LICENSE_KEY=
