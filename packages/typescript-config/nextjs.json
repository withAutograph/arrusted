{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js TypeScript Config",
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "${configDir}/next-env.d.ts",
    "${configDir}/.next/types/**/*.ts",
    "${configDir}/.next/dev/types/**/*.ts",
    "${configDir}/**/*.mts",
    "${configDir}/**/*.ts",
    "${configDir}/**/*.tsx"
  ]
}
