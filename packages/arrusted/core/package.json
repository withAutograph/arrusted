{
  "name": "@arrusted/core",
  "version": "0.1.0-alpha.1",
  "private": false,
  "license": "MIT",
  "bin": {
    "arrusted": "./bin/arrusted.mjs"
  },
  "files": [
    "dist",
    "bin",
    "assets"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./data": {
      "source": "./src/data.ts",
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js",
      "default": "./dist/data.js"
    },
    "./artifact-helpers": {
      "source": "./src/artifact-helpers.ts",
      "types": "./dist/artifact-helpers.d.ts",
      "import": "./dist/artifact-helpers.js",
      "default": "./dist/artifact-helpers.js"
    },
    "./actor-binding": {
      "source": "./src/actor-binding.ts",
      "types": "./dist/actor-binding.d.ts",
      "import": "./dist/actor-binding.js",
      "default": "./dist/actor-binding.js"
    },
    "./errors": {
      "source": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./pool": {
      "source": "./src/pool.ts",
      "types": "./dist/pool.d.ts",
      "import": "./dist/pool.js",
      "default": "./dist/pool.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./client": {
      "source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./routes": {
      "source": "./src/routes.ts",
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js",
      "default": "./dist/routes.js"
    },
    "./next": {
      "source": "./src/next.ts",
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./cli": {
      "source": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vp test --config vite.config.ts --run",
    "build": "bun scripts/build.ts"
  },
  "dependencies": {
    "@libpg-query/parser": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@autograph/typescript-config": "workspace:*",
    "@autograph/vite-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "next": ">=16.0.0 <17.0.0",
    "react": ">=19.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
